meta {
  name: generateDummy
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/reports/generateDummy?timeDuration=month
  body: json
  auth: inherit
}

params:query {
  timeDuration: month
}

headers {
  timezone: Asia/Kolkata
}

body:json {
  {
    "properties": [ "engChargeAltVolts", "genTotalVA", "engTemp"],
    "anomaliesCount": true,
    "anomaliesByProperty": true,
    "pdm": false,
    "rul": false
  }
  
}
