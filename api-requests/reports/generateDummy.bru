meta {
  name: generateDummy
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/reports/generateDummy?propertyName=genTotalVA&timeDuration=year
  body: json
  auth: inherit
}

params:query {
  propertyName: genTotalVA
  timeDuration: year
}

headers {
  timezone: Asia/Kolkata
}

body:json {
  {
    "properties": [ "engOilPress", "genTotalVA", "engFuelLevelUnits", "engSpeedDisplay"]
  }
  
}
