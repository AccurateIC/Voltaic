meta {
  name: generateDummy
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/reports/generateDummy?timeDuration=year
  body: json
  auth: inherit
}

params:query {
  timeDuration: year
}

headers {
  timezone: Asia/Kolkata
}

body:json {
  {
    "timeDuration": "week",
    "properties": ["engFuelLevelUnits", "engSpeedDisplay"],
    "Time_Hours": 210,
    "RPM_Deviation_Percentage": 0.067,
    "Oil_Pressure": 1.88,
    "Power_Output_kW": 0.924,
    "Inverse_Fuel_Consumption": 0.825
  }
  
}
