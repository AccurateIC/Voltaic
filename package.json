{
  "name": "voltaic",
  "version": "1.0.0",
  "description": "Monorepo for Voltaic Web (Gen Set)",
  "scripts": {
    "dev:all": "pnpm --recursive --parallel run dev",
    "build:all": "pnpm --recursive --parallel run build"
