{
  "name": "voltaic",
  "version": "1.0.0",
  "description": "Monorepo for Voltaic Web (Gen Set)",
  "scripts": {
    "dev": "pnpm run build:packages && pnpm --recursive --parallel run dev",
    "dev:frontend": "pnpm run build:packages && pnpm --filter frontend run dev",
    "dev:backend": "pnpm run build:packages && pnpm --filter backend run dev",
    "dev:only": "pnpm --recursive --parallel run dev",
    "dev:frontend:only": "pnpm --filter frontend run dev",
    "dev:backend:only": "pnpm --filter backend run dev",
    "tuyau": "pnpm --filter backend run tuyau",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:apps": "pnpm --filter \"./apps/*\" run build",
    "build:err": "pnpm --filter @voltaic/err build",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "clean": "pnpm --recursive run clean",
    "clean:dist": "find . -name 'dist' -type d -not -path './node_modules/*' -exec rm -rf {} + 2>/dev/null || true",
    "clean:deps": "rm -rf node_modules && pnpm --recursive exec rm -rf node_modules",
    "lint": "pnpm --recursive --parallel run lint",
    "lint:fix": "pnpm --recursive --parallel run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm --recursive --parallel run type-check",
    "test": "pnpm --recursive --parallel run test",
    "fresh": "pnpm run clean:deps && pnpm install && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AccurateIC/Voltaic.git"
  },
  "author": "Swarnim Barapatre",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AccurateIC/Voltaic/issues"
  },
  "homepage": "https://github.com/AccurateIC/Voltaic#readme",
  "resolutions": {
    "strtok3": "8.0.1"
  },
  "pnpm": {
    "overrides": {
      "strtok3": "8.0.1"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.12.4"
  }
}
